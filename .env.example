POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transcription
DATABASE_URL=postgresql://postgres:postgres@db:5432/transcription

PORT=3000
NODE_ENV=production

WHISPER_MODEL_ID=small

WORKER_ENABLED=true
